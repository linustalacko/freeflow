<?xml version="1.0" encoding="UTF-8"?>
<!-- FreeFlow local speech-to-text: Parakeet-TDT via parakeet-mlx (stt_server.py).
     Serves /v1/audio/transcriptions AND the streaming /v1/realtime socket on
     127.0.0.1:8082. Point FreeFlow's "Transcription API URL" at
     http://127.0.0.1:8082/v1 and enable realtime streaming (see README).
     Replace YOUR_USERNAME; the venv needs: pip install parakeet-mlx aiohttp scipy -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freeflow.stt</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.freeflow-ft/venv/bin/python</string>
        <string>/Users/YOUR_USERNAME/.freeflow-stt/stt_server.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
        <key>STT_MODEL</key>
        <string>mlx-community/parakeet-tdt-0.6b-v2</string>
        <key>STT_PORT</key>
        <string>8082</string>
        <!-- Streaming: decode a window every 2s; settle words the last two windows agree
             on that ended ≥1s before the live edge; keep 10s of settled audio as context. -->
        <key>STT_PARTIAL_EVERY_S</key>
        <string>2.0</string>
        <key>STT_SETTLE_HORIZON_S</key>
        <string>1.0</string>
        <key>STT_LEFT_CONTEXT_S</key>
        <string>10.0</string>
        <!-- Memory: cap MLX's buffer cache (uncapped it grew to 17 GB and swapped the
             machine), wire the weights, and touch them while idle so they stay resident. -->
        <key>STT_CACHE_MB</key>
        <string>512</string>
        <key>STT_WIRED_MB</key>
        <string>2048</string>
        <key>STT_HEARTBEAT_S</key>
        <string>45</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/stt-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/stt-server.log</string>
</dict>
</plist>
