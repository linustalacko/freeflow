<?xml version="1.0" encoding="UTF-8"?>
<!-- Replace YOUR_USERNAME and YOUR_GROQ_API_KEY (free at https://console.groq.com).
     Leave the key blank to run FULLY LOCAL (always falls back to Ollama). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freeflow.router</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOUR_USERNAME/.freeflow-stt/router.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GROQ_API_KEY</key>
        <string>YOUR_GROQ_API_KEY</string>
        <key>ROUTER_PORT</key>
        <string>11435</string>
        <key>LOCAL_MODEL</key>
        <string>llama3.1:8b</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/router.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/router.log</string>
</dict>
</plist>
