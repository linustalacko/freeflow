<?xml version="1.0" encoding="UTF-8"?>
<!-- Replace YOUR_USERNAME, then place in ~/Library/LaunchAgents/. RAM-capped for ~24GB Macs.
     Runs through start-ollama.sh so it steps aside (exit 0, no restart loop) if the
     Ollama desktop app already owns the port. Copy start-ollama.sh next to router.py. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freeflow.ollama</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/.freeflow-stt/start-ollama.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
        <key>OLLAMA_HOST</key>
        <string>127.0.0.1:11434</string>
        <key>OLLAMA_MAX_LOADED_MODELS</key>
        <string>1</string>
        <key>OLLAMA_NUM_PARALLEL</key>
        <string>1</string>
        <!-- Keep the fallback model resident between dictations: a cold load of an
             8B model is ~8s, which is most of FreeFlow's 20s budget. Match
             LOCAL_KEEPALIVE_S in com.freeflow.router.plist. -->
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>30m</string>
        <key>OLLAMA_CONTEXT_LENGTH</key>
        <string>8192</string>
        <key>OLLAMA_MAX_QUEUE</key>
        <string>8</string>
        <key>OLLAMA_FLASH_ATTENTION</key>
        <string>1</string>
        <key>OLLAMA_KV_CACHE_TYPE</key>
        <string>q8_0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- Restart only if it crashes; a clean exit means "someone else is serving". -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/ollama.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/ollama.log</string>
</dict>
</plist>
