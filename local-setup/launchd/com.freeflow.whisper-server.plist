<?xml version="1.0" encoding="UTF-8"?>
<!-- Replace YOUR_USERNAME, then place in ~/Library/LaunchAgents/ -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freeflow.whisper-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/whisper-server</string>
        <string>--model</string>
        <string>/Users/YOUR_USERNAME/.freeflow-stt/models/ggml-large-v3-turbo-q5_0.bin</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
        <string>--threads</string>
        <string>4</string>
        <string>--inference-path</string>
        <string>/v1/audio/transcriptions</string>
        <string>--vad</string>
        <string>--vad-model</string>
        <string>/Users/YOUR_USERNAME/.freeflow-stt/models/ggml-silero-v5.1.2.bin</string>
        <string>--vad-threshold</string>
        <string>0.5</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/whisper-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.freeflow-stt/whisper-server.log</string>
</dict>
</plist>
